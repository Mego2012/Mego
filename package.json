{
  "name": "mego-nutrition",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node e2e/run-e2e.mjs",
    "typecheck": "tsc -b",
    "e2e:scroll": "node e2e/scroll-test.mjs",
    "e2e:laptop": "node e2e/laptop-setup-test.mjs",
    "setup:laptop": "node scripts/laptop-setup.mjs",
    "e2e:multi": "firebase emulators:exec --project demo-mego --only firestore,auth \"node e2e/multiuser-test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-mego --only firestore,auth \"vitest run --config vitest.rules.config.ts\"",
    "i18n:crawl": "VITE_DEMO=1 vite build --outDir dist-demo && node e2e/i18n-crawl.cjs --strict"
  },
  "dependencies": {
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "firebase": "13.1.0",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "firebase-tools": "15.34.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
