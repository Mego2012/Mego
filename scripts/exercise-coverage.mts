/** Writes docs/EXERCISE-GUIDE-COVERAGE.md — a checklist for every built-in exercise. Usage: npx tsx scripts/exercise-coverage.mts */
import { writeFileSync } from 'node:fs';
import { EXERCISES } from '../src/lib/exercises';
import { VISUALS } from '../src/lib/exerciseVisuals';
import { TECHNIQUE } from '../src/lib/technique';
const ok = (b: boolean) => (b ? '✅' : '❌');
const rows = EXERCISES.map((e, i) => {
  const v = VISUALS[e.id], t = TECHNIQUE[e.id];
  const tech = !!t && t.setupEn.length >= 3 && t.stepsEn.length >= 3 && t.mistakesEn.length >= 3 && t.safetyEn.length >= 2 && t.setupAr.length === t.setupEn.length;
  return `| ${i + 1} | ${e.nameEn} · ${e.nameAr} | ${ok(!!v)} ${v ? (v.view === 'front' ? 'front view' : 'side view') + (v.noteEn ? ' (variant noted)' : '') : ''} | ${ok(!!v)} start + finish + animated loop | ${ok(tech)} ${t ? `${t.setupEn.length}/${t.stepsEn.length}/${t.mistakesEn.length}/${t.safetyEn.length}` : ''} | ${ok(!!e.primary)} ${e.primary}${e.secondary.length ? ' + ' + e.secondary.join(', ') : ''} | ${ok(!!(e.nameAr && e.nameEn && t?.stepsAr.length))} |`;
});
const missing = EXERCISES.filter((e) => !VISUALS[e.id] || !TECHNIQUE[e.id]).map((e) => e.id);
writeFileSync('docs/EXERCISE-GUIDE-COVERAGE.md', `# Exercise guide coverage (${new Date().toISOString().slice(0, 10)})

Generated by \`scripts/exercise-coverage.mts\`; verified by \`tests/exercise-guide.test.ts\` and the browser check EX-GUIDE (all pages in Arabic and English).

**Visual content:** original MEGO illustrations — a proportioned figure posed from standard technique (joint angles + inverse kinematics so hands/feet stay on the bar, floor, pad or platform), equipment drawn in place, target muscles highlighted, start and finish frames and an animated loop of the full movement, plus a consistent front/back anatomical muscle chart.
**Not included:** photographs and videos. No freely licensed photo/video set showing correct start and finish positions for these exact exercises was available, and AI-generated images were not used as technique references. Every drawing was reviewed on a contact sheet (\`scripts/exercise-sheet.tsx\`).

Technique columns: setup / steps / common mistakes / safety points (each also has breathing, range of motion and tempo), English and Arabic.

| # | Exercise | Illustration | Positions | Technique (EN+AR) | Muscles | AR + EN |
| --- | --- | --- | --- | --- | --- | --- |
${rows.join('\n')}

**Exercises still lacking verified visual content:** ${missing.length ? missing.join(', ') : 'none of the 54 built-in exercises'}. Custom exercises that users create have no illustration; their page says so and shows the muscle chart and the user's own description.
`);
console.log('rows', rows.length, 'missing', missing.length);
