/**
 * Recipe nutrition audit: computes all library recipes (a) from the owner's food table when present
 * (tests/private, never committed) and (b) from the public USDA references only, and writes docs/RECIPE-AUDIT.md
 * with USDA-based values, unresolved ingredients and the recipes whose two results differ by > 15 %.
 * Usage: npx tsx scripts/recipe-audit.mts
 */
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { computeLibraryRecipe, indexFoods, LIBRARY } from '../src/lib/recipeEngine';
import { RECIPE_REF } from '../src/lib/recipeRefMap';
import { refById, setRefData } from '../src/lib/refFoods';
import { parseCSV, parseFoodRows } from '../src/lib/sheetImport';
import type { Food } from '../src/lib/types';

setRefData(JSON.parse(readFileSync('public/fooddb/usda.json', 'utf8')));
const priv = 'tests/private/foods-160.csv';
const owner: Food[] = existsSync(priv) ? parseFoodRows(parseCSV(readFileSync(priv, 'utf8'))).foods.map((p, i) => ({
  id: 'f' + i, nameAr: p.nameAr, nameEn: p.nameEn, category: p.category, per100: p.per100, state: p.state, stateLabel: p.stateLabel, prep: p.prep, notes: p.notes,
  source: 'sheet', archived: false, favorite: false, incomplete: false, servings: [], version: 1, createdAt: 0, updatedAt: 0, useCount: 0
} as unknown as Food)) : [];
const usda = LIBRARY.map((l) => computeLibraryRecipe(l, indexFoods([]), refById));
const mine = owner.length ? LIBRARY.map((l) => computeLibraryRecipe(l, indexFoods(owner), refById)) : [];
const r1 = (x: number) => Math.round(x);
const flags: string[] = [];
const rows = usda.map((c, i) => {
  const p = c.perServing;
  const issues: string[] = [];
  if (c.missing.length) issues.push('missing: ' + c.missing.join(', '));
  const macroKcal = p.protein * 4 + p.carbs * 4 + p.fat * 9;
  if (Math.abs(macroKcal - p.kcal) / Math.max(p.kcal, 1) > 0.15) issues.push('kcal ≠ 4P+4C+9F (>15 %)');
  if (p.kcal < 80 || p.kcal > 1300) issues.push('unusual kcal per serving');
  if (mine.length) {
    const m = mine[i].perServing.kcal;
    if (Math.abs(m - p.kcal) / Math.max(p.kcal, 1) > 0.15) issues.push(`owner table vs USDA differ ${r1(((m - p.kcal) / p.kcal) * 100)} %`);
  }
  if (c.lib.ingredients.some((g) => g[0] === 'واي بروتين (سكوب)')) issues.push('contains whey (owner entry under review)');
  if (issues.length) flags.push(`${c.lib.id} ${c.lib.nameEn}: ${issues.join('; ')}`);
  return `| ${c.lib.id} | ${c.lib.nameEn} | ${c.lib.servings} | ${r1(p.kcal)} | ${r1(p.protein)} | ${r1(p.carbs)} | ${r1(p.fat)} | ${c.gramsPerServing} | ${issues.join('; ') || '—'} |`;
});
const unresolved = [...new Set(usda.flatMap((c) => c.missing))];
const mapped = Object.values(RECIPE_REF).filter(Boolean).length;
const md = `# Recipe nutrition audit (${new Date().toISOString().slice(0, 10)})

Generated by \`scripts/recipe-audit.mts\`. Values per serving computed from **USDA FoodData Central references only**
(what a new account sees before adding its own foods). Ingredient map: ${mapped} hand-checked USDA references.
${owner.length ? `Cross-checked against the owner's own food table (${owner.length} foods, kept private — values not published here).` : 'Owner food table not present in this checkout — cross-check skipped.'}

* Recipes: **${usda.length}**; fully resolved: **${usda.filter((c) => c.ok).length}**.
* Unresolved ingredients: **${unresolved.length ? unresolved.join(', ') : 'none'}** — never estimated; the owner's own table contains them, so on the owner's account all ${owner.length ? (mine.filter((c) => c.ok).length) : '—'} recipes resolve.
* Energy check: per-serving kcal vs 4·P + 4·C + 9·F — flagged when they differ by > 15 % (fibre, alcohol-free).
* Flagged recipes: **${flags.length}**.

## Flags
${flags.length ? flags.map((f) => '* ' + f).join('\n') : 'None.'}

## All recipes (per serving, USDA-based)
| id | recipe | servings | kcal | protein g | carbs g | fat g | ingredients g/serving | notes |
| --- | --- | --- | --- | --- | --- | --- | --- | --- |
${rows.join('\n')}
`;
writeFileSync('docs/RECIPE-AUDIT.md', md);
console.log(`recipes ${usda.length} · ok ${usda.filter((c) => c.ok).length} · unresolved ${unresolved.join(', ') || 'none'} · flagged ${flags.length}`);
if (mine.length) console.log('owner-table resolved:', mine.filter((c) => c.ok).length);
for (const f of flags) console.log(' -', f);
